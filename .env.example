APP_ENV=development
APP_NAME=UniAgent
APP_VERSION=0.1.0
DEBUG=true

API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_RANDOM_SECRET_KEY_32_BYTES

JWT_ALGORITHM=HS256

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=uniagent
POSTGRES_USER=uniagent
POSTGRES_PASSWORD=CHANGE_ME

DATABASE_URL=postgresql+asyncpg://uniagent:CHANGE_ME@db:5432/uniagent

VECTOR_DIMENSIONS=1536

# NOTE: most of this file configures the unused FastAPI/PostgreSQL backend
# under backend/ (see README - it isn't wired up to anything yet). The line
# below, OPENAI_API_KEY, is the one that actually matters right now: it's
# read directly by server.ts, the real running app, and is preferred over
# GEMINI_API_KEY (further down) whenever both are set.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.75

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

LOG_LEVEL=INFO
ENABLE_AGENT_TRACING=true

# Also read directly by server.ts - used only if OPENAI_API_KEY above is not set.
GEMINI_API_KEY=""

# Read directly by server.ts to power Job Search & Apply (South Africa
# listings, via Adzuna). Free developer account: https://developer.adzuna.com
# Without both set, job search honestly reports itself as not configured
# instead of returning nothing or fabricated listings.
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# Read directly by server.ts to use Firebase's real Firestore database
# instead of the local JSON file below - the right choice once this is
# deployed somewhere real (Cloud Run, Firebase App Hosting) rather than run
# on one person's own computer. Leave blank to keep using the local file.
FIREBASE_PROJECT_ID=""
# Only needed for local Docker use with Firestore - the path to a service
# account JSON key file (downloaded from your Firebase project's Settings ->
# Service Accounts -> Generate new private key), mounted into the container.
# Not needed at all when actually running ON Google Cloud infrastructure -
# credentials are supplied automatically there.
GOOGLE_APPLICATION_CREDENTIALS=""

# Where your real account/workspace data is stored on THIS machine (read by
# docker-compose.yml). Leave unset and it defaults to a "data" folder next
# to docker-compose.yml - fine for a single install you never move. But if
# you expect to extract future updates into a new folder (a new zip), set
# this to a stable folder OUTSIDE any versioned project folder instead, e.g.
# on Windows:
#   UNIAGENT_HOST_DATA_DIR=C:/UniAgentData
# so every future update keeps pointing at the same real data and nothing
# is lost when you move to a new folder.
UNIAGENT_HOST_DATA_DIR=""
APP_URL=""

